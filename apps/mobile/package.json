{
  "name": "@side/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.4",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-constants": "~58.0.12",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-sse": "^1.2.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "openapi-typescript": "^7.13.0",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start:mock": "EXPO_PUBLIC_SIDE_MOCK=1 expo start",
    "gen:api": "openapi-typescript ../../contracts/openapi.yaml -o src/api/schema.d.ts",
    "check:api": "openapi-typescript ../../contracts/openapi.yaml -o /tmp/side-schema.d.ts && diff -q src/api/schema.d.ts /tmp/side-schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "doctor": "expo-doctor"
  },
  "private": true,
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ]
  }
}
