{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "allowJs": false,
    "isolatedModules": true
  },
  "include": ["dist/react-native/*.ts", "dist/tailwind/*.d.ts", "test/types/*.ts"]
}
