# Copy to deploy/.env — docker compose reads it automatically. Everything is optional:
# with no values set the stack runs offline with the `mock` agent.

# --- Host ports ---
SIDE_API_PORT=8000
SIDE_NOTIFICATIONS_PORT=8010
SIDE_WEB_PORT=3000

# --- Image naming (CI publishes ghcr.io/<owner>/side-<service>) ---
SIDE_IMAGE_PREFIX=side
SIDE_IMAGE_TAG=local

# --- LLM agents (only needed for agent type openai / anthropic) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- API ---
# Where the API forwards `status` RunEvents (see ARCHITECTURE.md "Notifications contract").
SIDE_NOTIFY_URL=http://notifications:8010
# Browser origins allowed to call the API (web on :3000).
SIDE_CORS_ORIGINS=http://localhost:3000
# Override the auto-detected ASGI app, e.g. side_api.main:app
SIDE_API_APP=

# --- Notifications ---
# Expo access token for push delivery (optional; without it pushes are not sent).
EXPO_ACCESS_TOKEN=
SIDE_NOTIFICATIONS_APP=

# --- Web ---
# Browser-side API base URL, inlined at build time (rebuild web after changing).
NEXT_PUBLIC_SIDE_API_URL=http://localhost:8000/api/v1
# 1 = run the web app against fixtures, no backend needed.
NEXT_PUBLIC_SIDE_MOCK=0
# Server-side API base URL (inside the compose network).
SIDE_API_URL=http://api:8000/api/v1
